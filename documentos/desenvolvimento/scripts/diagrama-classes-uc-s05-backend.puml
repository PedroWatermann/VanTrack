@startuml diagrama-classes-uc-s05-backend
' Diagrama 2 de 3 — Back-end do UC-S05: apresentação, aplicação e infraestrutura.
' As entidades aparecem só com o nome; atributos e operações estão no Diagrama 1
' (diagrama-classes-uc-s05.puml). Task B-01; atualizado com o código real da
' desenvolvimento na task B-12 (VT-64).

title UC-S05 Registrar Embarque — Diagrama de classes (2/3): camadas do back-end

set namespaceSeparator none
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
hide empty members
' Camadas da esquerda para a direita: o diagrama fica legível numa página.
left to right direction

' ===================================================================
package "domínio (detalhado no Diagrama 1)" as dom {
  class Presenca
  class Rota
  class Notificacao
  class Usuario
  class Aluno
  class Sessao
  class Localizacao <<value object>>
  enum SituacaoPresenca
  enum TipoMovimentacao
  enum Papel
  interface SessaoRepository <<contrato>>
  interface UsuarioRepository <<contrato>>
  interface PresencaRepository <<contrato>>
  interface RotaRepository <<contrato>>
  interface VinculoRepository <<contrato>>
  interface NotificacaoRepository <<contrato>>
}

' ===================================================================
' Login: apoio, fora do ciclo de implementação. lib/autenticacao/ (movido de
' lib/compartilhado/ no Bug VT-71, ponto 15 do 03-arquitetura.md).
package "autenticação :: apresentação (apoio)" as aut_apr {
  class AutenticacaoController <<apoio>> {
    + service : AutenticacaoService {readOnly}
    + listarUsuarios(metodo : HttpMethod) : Future<Response>
    + entrar(pedido : Request) : Future<Response>
  }
  class AutenticacaoMiddleware <<apoio>> {
    + sessoes : SessaoRepository {readOnly}
    + identificar(token : String?) : Future<UsuarioLogado>
    + middleware() : Middleware
  }
}

package "compartilhado :: apresentação" as comp_apr {
  class UsuarioLogado <<apoio>> {
    + id : int {readOnly}
    + papel : Papel {readOnly}
  }
}

note bottom of comp_apr
  Identidade da requisição, recebida pelos
  controllers de todos os módulos; fica no
  compartilhado para não criar ciclo (VT-71).
end note

' ===================================================================
package "cadastro :: aplicação e apresentação (VT-70)" as cad_apl {
  class AlunoController {
    + service : AlunoService {readOnly}
    + listarDoResponsavel(pedido : Request, usuario : UsuarioLogado) : Future<Response>
  }
  class AlunoService {
    - vinculoRepository : VinculoRepository
    + listarDoResponsavel(responsavelId : int) : Future<List<Aluno>>
  }
}

note bottom of cad_apl
  GET /alunos: alunos do responsável logado,
  para os cards da tela "Avisos" (RN-002, UC-I02).
end note

package "autenticação :: aplicação (apoio)" as aut_apl {
  class AutenticacaoService <<apoio>> {
    + usuarios : UsuarioRepository {readOnly}
    + sessoes : SessaoRepository {readOnly}
    + listarUsuarios() : Future<List<Usuario>>
    + entrar(id : int, papel : Papel) : Future<Sessao?>
  }
}

note bottom of aut_apr
  O middleware transforma o token do header
  Authorization em UsuarioLogado e o entrega
  às rotas (sem token válido -> 401).
end note

package "compartilhado :: aplicação" as comp_apl {
  class AcessoNegadoException <<exception>> {
    + mensagem : String {readOnly}
  }
  class NaoEncontradoException <<exception>> {
    + mensagem : String {readOnly}
  }
}

package "compartilhado :: infraestrutura" as comp_inf {
  class ConexaoBanco {
    - pool : Pool
    + {static} abrir(databaseUrl : String) : Future<ConexaoBanco>
    + executar(sql : String, parametros : Map<String, Object?>) : Future<Result>
    + emTransacao<T>(acao : Future<T> Function(TxSession)) : Future<T>
    + fechar() : Future<void>
  }
}

' ===================================================================
package "embarque :: apresentação" as emb_apr {
  class EmbarqueController {
    + service : EmbarqueService {readOnly}
    + buscarRotaDoDia(pedido : Request, usuario : UsuarioLogado) : Future<Response>
    + listarAlunos(rotaId : String, pedido : Request, usuario : UsuarioLogado) : Future<Response>
    + registrarEmbarque(rotaId : String, pedido : Request, usuario : UsuarioLogado) : Future<Response>
    + sincronizar(rotaId : String, pedido : Request, usuario : UsuarioLogado) : Future<Response>
    - traduzindoErros(acao : Future<Response> Function()) : Future<Response>
    - codigoDoRegistro(rotaId : int, item : Object?, motoristaId : int) : Future<int>
    - codigoHttpDe(erro : Exception) : int?
    - mensagemDe(erro : Exception) : String
  }
}

package "embarque :: aplicação" as emb_apl {
  class EmbarqueService {
    - rotaRepository : RotaRepository
    - presencaRepository : PresencaRepository
    - vinculoRepository : VinculoRepository
    - notificacaoService : NotificacaoService
    - relogio : DateTime Function()
    + buscarRotaDoDia(motoristaId : int) : Future<Rota>
    + listarAlunosConfirmados(rotaId : int, motoristaId : int) : Future<List<Presenca>>
    + registrarEmbarque(rotaId : int, alunoId : int, registroId : String, dataHora : DateTime, motoristaId : int, localizacao : Localizacao?) : Future<ResultadoRegistro>
    - validarMotoristaAtivo(rota : Rota, motoristaId : int) : Future<void>
    - jaProcessado(alunoId : int, presenca : Presenca) : ResultadoRegistro
  }

  class ResultadoRegistro {
    + alunoId : int {readOnly}
    + situacao : SituacaoPresenca {readOnly}
    + jaProcessado : bool {readOnly}
  }
}

note bottom of emb_apl
  registrarEmbarque usa parâmetros nomeados em Dart.
  relogio é injetável para testar o "hoje" em
  horário de Brasília (buscarRotaDoDia).
end note

' ===================================================================
package "notificacao :: apresentação" as not_apr {
  class NotificacaoController {
    + avisosService : AvisosService {readOnly}
    + listar(pedido : Request, usuario : UsuarioLogado) : Future<Response>
    + marcarComoLida(notificacaoId : String, pedido : Request, usuario : UsuarioLogado) : Future<Response>
  }
}

package "notificacao :: aplicação" as not_apl {
  interface NotificacaoService <<contrato>> {
    + notificarMovimentacao(presenca : Presenca, tipo : TipoMovimentacao) : Future<void>
  }

  class NotificacaoServiceVazio {
    + notificarMovimentacao(presenca : Presenca, tipo : TipoMovimentacao) : Future<void>
  }

  class NotificacaoServicePadrao {
    + vinculoRepository : VinculoRepository {readOnly}
    + notificacaoRepository : NotificacaoRepository {readOnly}
    + notificarMovimentacao(presenca : Presenca, tipo : TipoMovimentacao) : Future<void>
  }

  class AvisosService {
    + notificacaoRepository : NotificacaoRepository {readOnly}
    + listarDoResponsavel(responsavelId : int, desde : DateTime?) : Future<List<Notificacao>>
    + marcarComoLida(notificacaoId : int, responsavelId : int) : Future<void>
  }
}

' ===================================================================
package "infraestrutura (implementações Postgres)" as infra {
  class PresencaRepositoryPostgres {
    - obterConexao : Future<ConexaoBanco> Function()
  }
  class RotaRepositoryPostgres {
    - obterConexao : Future<ConexaoBanco> Function()
  }
  class VinculoRepositoryPostgres {
    - obterConexao : Future<ConexaoBanco> Function()
  }
  class NotificacaoRepositoryPostgres {
    - obterConexao : Future<ConexaoBanco> Function()
  }
  class SessaoRepositoryPostgres {
    + obterConexao : Future<ConexaoBanco> Function() {readOnly}
  }
}

note top of infra
  Cada implementação fica na pasta
  infraestrutura/ do seu módulo
  (rota, cadastro, notificacao, autenticacao)
  e implementa todas as operações do
  contrato (listadas no Diagrama 1).
  Recebem uma função que abre a conexão
  (pool único em ConexaoBanco.abrir).
end note

' ===================================================================
' Apresentação -> aplicação
EmbarqueController --> "1" EmbarqueService
EmbarqueController ..> UsuarioLogado
EmbarqueController ..> AcessoNegadoException : <<converte em 403>>
EmbarqueController ..> NaoEncontradoException : <<converte em 404>>
NotificacaoController --> "1" AvisosService
NotificacaoController ..> UsuarioLogado
AutenticacaoController --> "1" AutenticacaoService
AlunoController --> "1" AlunoService
AlunoController ..> UsuarioLogado
AlunoService --> "1" VinculoRepository
AlunoService ..> Aluno
UsuarioLogado --> Papel
AutenticacaoMiddleware --> "1" SessaoRepository
AutenticacaoMiddleware ..> UsuarioLogado : <<cria>>

' Aplicação -> domínio (contratos)
EmbarqueService --> "1" RotaRepository
EmbarqueService --> "1" PresencaRepository
EmbarqueService --> "1" VinculoRepository
EmbarqueService --> "1" NotificacaoService : «include» UC-I02 >
EmbarqueService ..> Presenca : registrarEmbarque()
EmbarqueService ..> ResultadoRegistro : <<cria>>
EmbarqueService ..> AcessoNegadoException : <<lança>>
EmbarqueService ..> NaoEncontradoException : <<lança>>

AutenticacaoService --> "1" UsuarioRepository
AutenticacaoService --> "1" SessaoRepository
AutenticacaoService ..> Sessao : <<cria>>

NotificacaoServiceVazio ..|> NotificacaoService
NotificacaoServicePadrao ..|> NotificacaoService
NotificacaoServicePadrao --> "1" VinculoRepository
NotificacaoServicePadrao --> "1" NotificacaoRepository
NotificacaoServicePadrao ..> Notificacao : <<cria>> deEmbarque()
AvisosService --> "1" NotificacaoRepository
AvisosService ..> AcessoNegadoException : <<lança>>
AvisosService ..> NaoEncontradoException : <<lança>>

' Infraestrutura realiza os contratos do domínio
PresencaRepositoryPostgres ..|> PresencaRepository
RotaRepositoryPostgres ..|> RotaRepository
VinculoRepositoryPostgres ..|> VinculoRepository
NotificacaoRepositoryPostgres ..|> NotificacaoRepository
SessaoRepositoryPostgres ..|> SessaoRepository
SessaoRepositoryPostgres ..|> UsuarioRepository
PresencaRepositoryPostgres ..> ConexaoBanco
RotaRepositoryPostgres ..> ConexaoBanco
VinculoRepositoryPostgres ..> ConexaoBanco
NotificacaoRepositoryPostgres ..> ConexaoBanco
SessaoRepositoryPostgres ..> ConexaoBanco

note right of EmbarqueService
  registrarEmbarque (UC-S05, passos 2 a 5):
  1. rota existe? senão 404
  2. motorista ativo da van? senão 403 (RN-012)
  3. registroId já processado? devolve 200
  4. presença do aluno na rota existe? senão 404
  5. presenca.registrarEmbarque(...) (RN-010, 409)
  6. presencaRepository.salvar (1 transação);
     unicidade recusada -> 200 (mesmo registro)
     ou 409 (outro registro)
  7. notificacaoService.notificarMovimentacao;
     se o aviso falhar: log e 201 (B-11)
end note

note bottom of NotificacaoServicePadrao
  UC-I02: busca os responsáveis (RN-002, RN-009),
  cria uma Notificacao por responsável e
  registra o comunicado.
  A1: sem responsável -> não cria nada.
end note

note bottom of comp_inf
  Composição: routes/_middleware.dart cria os
  repositórios Postgres e os services e os entrega
  aos controllers por provider.
end note

@enduml
