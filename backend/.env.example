# Copie este arquivo para backend/.env e preencha com a string do SEU projeto do Supabase:
# Supabase -> Project Settings -> Database -> Connection string -> modo "Session pooler".
# Troque [YOUR-PASSWORD] pela senha do banco (caracteres especiais precisam de URL encoding,
# ex.: @ vira %40). Nunca commite o .env.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
